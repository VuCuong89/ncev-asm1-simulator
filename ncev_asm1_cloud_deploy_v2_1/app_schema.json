    "influent": ["q", "cod", "bod5", "tss", "nh4", "tn", "nox", "alkalinity", "dissolved_oxygen", "temperature", "tp"],
    "process": ["v_anoxic", "v_aerobic", "internal_recycle_ratio", "ras_ratio", "was_flow_or_target_srt", "clarifier_capture", "kla_aerobic", "do_saturation", "simulation_days"],
    "carbon": ["source", "purity_pct", "density_kg_l", "tn_target"],
