    "phosphorus": ["tp_after_bio_mg_l", "p_remove_mg_l", "p_remove_kg_d", "product_dose_mg_l", "product_kg_d", "chemical_sludge_ds_kg_d"],
    "sludge": ["biological_was_ds_kg_d", "chemical_sludge_ds_kg_d", "total_ds_kg_d", "wet_sludge_m3_d"]
